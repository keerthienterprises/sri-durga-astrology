{
  "cleanUrls": true,
  "redirects": [
    { "source": "/birth-chart-template.html", "destination": "/", "permanent": true },
    { "source": "/birth-chart-template", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ]
    }
  ]
}
